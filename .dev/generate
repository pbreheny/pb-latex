#!/usr/bin/env python3

from pathlib import Path
import json
import re
import string

ROOT = Path(__file__).resolve().parents[1]

SRC = ROOT / ".dev"
OUT = ROOT / "tex"
KATEX_OUT = ROOT / "katex"

PROBLEM_LOWERCASE = ["c", "d", "u", "v"]
SAFE_LOWERCASE = [x for x in string.ascii_lowercase if x not in PROBLEM_LOWERCASE]
HAT_LETTERS = ["f", "s", "t", "y"]
SUBSCRIPT_LETTERS = ["r", "x", "X"]
TILDE_LETTERS = ["r", "w", "x", "y", "z"]

GREEK = {
    "a": "alpha",
    "b": "beta",
    "g": "gamma",
    "d": "delta",
    "eps": "epsilon",
    "vep": "varepsilon",
    "e": "eta",
    "t": "theta",
    "l": "lambda",
    "mu": "mu",
    "n": "nu",
    "p": "pi",
    "s": "sigma",
    "tau": "tau",
    "psi": "psi",
    "G": "Gamma",
    "L": "Lambda",
    "O": "Omega",
    "S": "Sigma",
    "T": "Theta",
}
GREEK_ABBREVIATIONS = {
    "eps": "epsilon",
    "vep": "varepsilon",
    "gam": "gamma",
    "lam": "lambda",
    "Lam": "Lambda"
}
GA_REV = {v: k for k, v in GREEK_ABBREVIATIONS.items()}
GREEK_STAR = ["b", "t", "T"]
GREEK_TILDE = ["b", "e", "l", "mu", "n", "t"]


def read(path: Path) -> str:
    return path.read_text(encoding="utf-8").rstrip() + "\n"


def bold_letter(letter: str, engine: str) -> str:
    if engine == "traditional":
        return rf"\mathbf{{{letter}}}"
    if engine == "unicode":
        return rf"\symbf{{{letter}}}"
    if engine == "katex":
        return rf"\mathbf{{{letter}}}"
    raise ValueError(engine)


def bold_symbol(symbol: str, engine: str) -> str:
    if engine == "traditional":
        return rf"\bm{{\{symbol}}}"
    if engine == "unicode":
        return rf"\symbf{{\{symbol}}}"
    if engine == "katex":
        return rf"\boldsymbol{{\{symbol}}}"
    raise ValueError(engine)


def make_letter_macros(engine: str) -> str:
    lines = []

    lines.append("% Bold numbers")
    lines.append(rf"\providecommand{{\zero}}{{{bold_letter("0", engine)}}}")
    lines.append(rf"\providecommand{{\one}}{{{bold_letter("1", engine)}}}")

    lines.append("")
    lines.append("% Bold capital letters")
    for x in string.ascii_uppercase:
        lines.append(rf"\def\{x}{{{bold_letter(x, engine)}}}")

    lines.append("")
    lines.append("% Bold lowercase letters")
    for x in SAFE_LOWERCASE:
        lines.append(rf"\def\{x}{{{bold_letter(x, engine)}}}")
    for x in PROBLEM_LOWERCASE:
        if engine == "katex":
            # KaTeX is math-only, so no text-mode accent guard is needed
            lines.append(rf"\def\{x}{{{bold_letter(x, engine)}}}")
            continue
        if engine == "traditional":
            spaces = "                                                          "
        else:
            spaces = "                                                         "
        lines.append(rf"\let\orig{x}\{x}{spaces}% chktex 14")
        lines.append(rf"\DeclareRobustCommand\{x}{{\ifmmode{bold_letter(x, engine)}\else\expandafter\orig{x}\fi}} % chktex 41")

    lines.append("")
    lines.append("% Letters with hats")
    for x in HAT_LETTERS:
        lines.append(rf"\providecommand{{\{x}hat}}{{\hat{{{x}}}}}")
    for x in HAT_LETTERS:
        lines.append(rf"\providecommand{{\b{x}hat}}{{\hat{{{bold_letter(x, engine)}}}}}")
  
    lines.append("")
    lines.append("% Letters with subscripts")
    for x in SUBSCRIPT_LETTERS:
        lines.append(rf"\providecommand{{\{x}j}}{{{bold_letter(x, engine)}_{{-j}}}}")

    lines.append("")
    lines.append("% Letters with tildes")
    for x in TILDE_LETTERS:
        lines.append(rf"\providecommand{{\{x}{x}}}{{\tilde{{{x}}}}}")
    for x in TILDE_LETTERS:
        lines.append(rf"\providecommand{{\b{x}{x}}}{{\tilde{{{bold_letter(x, engine)}}}}}")
    for x in TILDE_LETTERS:
        if x == "r":
            continue
        X = x.upper()
        lines.append(rf"\providecommand{{\{X}{X}}}{{\tilde{{{bold_letter(X, engine)}}}}}")
  
    lines.append("")
    lines.append("% Calligraphic capital letters")
    for x in string.ascii_uppercase:
        lines.append(rf"\providecommand{{\c{x}}}{{\mathcal{{{x}}}}}")

    lines.append("")
    lines.append("% Greek letters (shortcuts)")
    for x in sorted(GREEK_ABBREVIATIONS.keys()):
        lines.append(rf"\providecommand{{\{x}}}{{\{GREEK_ABBREVIATIONS[x]}}}")

    lines.append("")
    lines.append("% Bold Greek letters")
    for x in sorted(GREEK.keys()):
        lines.append(rf"\providecommand{{\b{x}}}{{{bold_symbol(GREEK[x], engine)}}}")
  
    lines.append("")
    lines.append("% Greek letters with hats")
    for x in sorted(GREEK.keys()):
        lines.append(rf"\def\{x}h{{\hat{{\{GREEK[x]}}}}}")

    lines.append("")
    lines.append("% Bold Greek letters with hats")
    for x in sorted(GREEK.keys()):
        lines.append(rf"\providecommand{{\b{x}h}}{{\hat{{{bold_symbol(GREEK[x], engine)}}}}}")

    lines.append("")
    lines.append("% Greek letters with stars")
    lines.append(r"\providecommand{\ts}{\theta^{*}}")
    for x in GREEK_STAR:
        lines.append(rf"\providecommand{{\b{x}s}}{{{bold_symbol(GREEK[x], engine)}^{{*}}}}")

    lines.append("")
    lines.append("% Greek letters with subscripts")
    lines.append(rf"\providecommand{{\bbj}}{{{bold_symbol("beta", engine)}_{{-j}}}}")
    lines.append(rf"\providecommand{{\bbhj}}{{\hat{{{bold_symbol("beta", engine)}}}_{{-j}}}}")
    lines.append(rf"\providecommand{{\bbtj}}{{\tilde{{{bold_symbol("beta", engine)}}}_{{-j}}}}")

    lines.append("")
    lines.append("% Greek letters with tildes")
    for letter in GREEK_TILDE:
        if GREEK[letter] in GREEK_ABBREVIATIONS.values():
            x = GA_REV[GREEK[letter]]
        else:
            x = GREEK[letter]
        lines.append(rf"\providecommand{{\{x}t}}{{\tilde{{\{GREEK[letter]}}}}}")

    lines.append("")
    lines.append("% Bold Greek letters with tildes")
    for x in GREEK_TILDE:
        lines.append(rf"\providecommand{{\b{x}t}}{{\tilde{{{bold_symbol(GREEK[x], engine)}}}}}")

    return "\n".join(lines) + "\n"


def build(engine: str) -> str:
    specific = read(SRC / f"{engine}.tex")
    core = read(SRC / "core.tex")
    letters = make_letter_macros(engine)

    return "\n".join([
        specific.rstrip(),
        "",
        core.rstrip(),
        "",
        letters.rstrip(),
        ""
    ])


def read_group(text: str, i: int) -> tuple[str, int]:
    """Read a balanced {...} group starting at text[i]; return (contents, next index)."""
    if text[i] != "{":
        raise ValueError(f"Expected '{{' at position {i} in: {text}")
    depth = 0
    for j in range(i, len(text)):
        if text[j] == "\\":
            continue
        if text[j] == "{" and text[j - 1] != "\\":
            depth += 1
        elif text[j] == "}" and text[j - 1] != "\\":
            depth -= 1
            if depth == 0:
                return text[i + 1:j], j + 1
    raise ValueError(f"Unbalanced braces in: {text}")


def strip_comment(line: str) -> str:
    return re.sub(r"(?<!\\)%.*", "", line).strip()


KATEX_SKIP = re.compile(r"\\(usepackage|numberwithin|set\w*font|let|ifdefined|DeclareMathAlphabet)\b")
NAME = re.compile(r"\\([A-Za-z]+)")


def latex_to_katex(tex: str) -> list[tuple[str, str] | str]:
    """
    Convert LaTeX macro definitions into KaTeX (name, expansion) pairs.
    Section comments ("% Foo") are passed through as strings.
    Unrecognized definitions raise an error rather than being silently dropped.
    """
    out = []
    for raw in tex.splitlines():
        if re.match(r"^\s*%\s*\S", raw) and not raw.strip().startswith("%%"):
            out.append(raw.strip().lstrip("%").strip())
            continue
        line = strip_comment(raw)
        if not line or KATEX_SKIP.match(line):
            continue

        m = re.match(r"\\DeclareMathOperator(\*?)\{\\([A-Za-z]+)\}", line)
        if m:
            body, _ = read_group(line, m.end())
            out.append((m.group(2), rf"\operatorname{m.group(1)}{{{body}}}"))
            continue

        m = re.match(r"\\DeclarePairedDelimiter\{\\([A-Za-z]+)\}", line)
        if m:
            left, i = read_group(line, m.end())
            right, _ = read_group(line, i)
            out.append((m.group(1), rf"{left} #1 {right}"))
            continue

        m = re.match(r"\\(?:providecommand|newcommand|renewcommand)\{\\([A-Za-z]+)\}(?:\[\d\])?", line)
        if m:
            body, _ = read_group(line, m.end())
            out.append((m.group(1), body))
            continue

        m = re.match(r"\\def\\([A-Za-z]+)", line)
        if m:
            body, _ = read_group(line, m.end())
            out.append((m.group(1), body))
            continue

        raise ValueError(f"Don't know how to convert to KaTeX: {raw}")
    return out


def build_katex() -> str:
    tex = "\n".join([
        read(SRC / "katex.tex"),
        read(SRC / "core.tex"),
        make_letter_macros("katex"),
    ])
    lines = []
    for item in latex_to_katex(tex):
        if isinstance(item, str):
            if lines:
                lines.append("")
            lines.append(f"        // {item}")
        else:
            name, body = item
            lines.append(f"        {json.dumps('\\' + name)}: {json.dumps(body)},")
    # Drop trailing comma on the last entry
    lines[-1] = lines[-1].rstrip(",")
    template = read(SRC / "katex.html")
    return template.replace("%%MACROS%%", "\n".join(lines))


OUT.mkdir(exist_ok=True)

for engine in ["traditional", "unicode"]:
    target = OUT / f"math-{engine}.tex"
    target.write_text(build(engine), encoding="utf-8")
    print(f"Wrote {target}")

KATEX_OUT.mkdir(exist_ok=True)
target = KATEX_OUT / "katex.html"
target.write_text(build_katex(), encoding="utf-8")
print(f"Wrote {target}")
